# ────────────────────────────────────────────────────
# NEXUS 3.0 — Environment Variables
# Copy to .env for local dev. Set in Vercel dashboard for production.
# ────────────────────────────────────────────────────

# ── TMDB API (REQUIRED) ────────────────────────────
# Get a free v4 read access token from themoviedb.org/settings/api
TMDB_READ_API_KEY=

# ── TMDB-Embed API (REQUIRED for Embeds providers) ─
# HuggingFace Space that aggregates 7 streaming providers
VITE_TMDB_EMBED_URL=https://stycanine1-tmdb-embed-api.hf.space

# ── CORS Proxy (optional — helps with stream CORS) ──
# No trailing slash
VITE_CORS_PROXY_URL=

# ── M3U8 / Stream Proxy (optional) ─────────────────
VITE_M3U8_PROXY_URL=

# ── App Domain ─────────────────────────────────────
VITE_APP_DOMAIN=http://localhost:5173

# ── Backend URL(s) (optional — for accounts/sync) ──
VITE_BACKEND_URL=

# ── Feature Flags ──────────────────────────────────
VITE_NORMAL_ROUTER=true
VITE_PWA_ENABLED=true
VITE_ALLOW_AUTOPLAY=true
VITE_HAS_ONBOARDING=true
VITE_HIDE_PROXY_SETTINGS=false

# ── Trakt Integration (optional) ───────────────────
VITE_TRAKT_CLIENT_ID=
VITE_TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=

# ── Analytics (optional) ───────────────────────────
VITE_TRACK_SCRIPT=

# ── Adsterra ads (optional — see .env.local for a filled example) ──
VITE_ENABLE_POPUNDER=false
VITE_POPUNDER_SCRIPT_URL=
VITE_POPUNDER_COOLDOWN_HOURS=2
VITE_ENABLE_SOCIAL_BAR=false
VITE_SOCIAL_BAR_SCRIPT_URL=
VITE_ENABLE_SMARTLINK=false
VITE_SMARTLINK_URL=
# ── 468×60 banner under the player ──
VITE_ENABLE_PLAYER_BANNER=false
VITE_PLAYER_BANNER_ZONE_ID=
VITE_PLAYER_BANNER_INVOKE_KEY=

# ── Monetag (eligible browsing pages; never the player) ────────────────
# Multitag officially contains Onclick, Push Notifications, In-Page Push,
# and Vignette Banner. Use the verified Multitag OR separate zones, not both.
# Requires public/sw.js at the site root for HTTPS verification.
VITE_ENABLE_MONETAG_ONCLICK=false
VITE_MONETAG_ONCLICK_URL=
VITE_ENABLE_MONETAG_INPAGE=false
VITE_MONETAG_INPAGE_URL=
VITE_ENABLE_MONETAG_VIGNETTE=false
VITE_MONETAG_VIGNETTE_URL=
VITE_ENABLE_MONETAG_MULTITAG=false
VITE_MONETAG_MULTITAG_URL=
VITE_MONETAG_MULTITAG_ZONE=
# Monetag domain verification — token from Monetag → Websites → Verification
# (meta tag option). Empty = the <meta name="monetag"> tag is not rendered.
VITE_MONETAG_VERIFICATION_TOKEN=
