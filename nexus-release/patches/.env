# ============================================================
# NEXUS — Environment Configuration (.env)
# ============================================================
# Copy this file to the project ROOT as ".env" (the setup script does this
# automatically). Fill in the values marked  <<< FILL IN >>>  before running.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ============================================================

# ── TMDB (REQUIRED) ─────────────────────────────────────────
# Get a free "API Read Access Token" (v4 auth) from:
#   https://www.themoviedb.org/settings/api
# This is the long eyJ... JWT token, NOT the short v3 key.
VITE_TMDB_READ_API_KEY=<<< FILL IN: your TMDB v4 read access token >>>

# ── MovieBox VPS backend (REQUIRED for MovieBox provider) ───
# The base URL where you deployed walterwhite-69/Moviebox-API.
# Example: https://moviebox.your-domain.com   (NO trailing slash)
# For local backend testing use: http://localhost:8000
VITE_MOVIEBOX_API_URL=<<< FILL IN: your MovieBox VPS URL, e.g. https://moviebox.your-vps.com >>>

# ── NEXUS TMDB-Embed backend (HuggingFace Space) ────────────
# The zeticuz TMDB-Embed-API deployed on HuggingFace.
# Default is the public NEXUS space; change if you host your own.
VITE_TMDB_EMBED_API_URL=https://zetic7z-tmdb-embed-api.hf.space

# ── Proxies (recommended — fixes CORS on stream CDNs) ───────
# CORS proxy (comma-separated for failover). Deploy your own with
# xp-technologies-dev/simple-proxy, or use a hosted one you trust.
VITE_CORS_PROXY_URL=<<< FILL IN: https://your-cors-proxy.workers.dev >>>

# M3U8 / stream proxy (comma-separated). Used to proxy HLS + protect origin.
VITE_M3U8_PROXY_URL=<<< FILL IN: https://your-m3u8-proxy.com >>>

# ── Backend (optional — user accounts / sync) ───────────────
# Only needed if you want login / bookmark sync. Leave blank to run
# NEXUS fully local with no accounts.
VITE_BACKEND_URL=

# ── App identity ────────────────────────────────────────────
VITE_APP_DOMAIN=http://localhost:5173
VITE_NORMAL_ROUTER=true

# ── Feature flags ───────────────────────────────────────────
VITE_PWA_ENABLED=true
VITE_HAS_ONBOARDING=true
VITE_ALLOW_AUTOPLAY=true
VITE_HIDE_PROXY_SETTINGS=false

# ── Analytics / tracking (optional, leave blank) ────────────
VITE_TRACK_SCRIPT=

# ============================================================
# NOTES
# ------------------------------------------------------------
# • MovieBox provider will simply be skipped (and hidden from the source
#   list by the health probe) if VITE_MOVIEBOX_API_URL is unreachable.
# • If you have NO cors/m3u8 proxy yet, streams from some providers may
#   fail to play in the browser due to CORS. MovieBox MP4 usually plays
#   direct, but a proxy is strongly recommended for the others.
# • Never commit your real .env to a public repo.
# ============================================================
